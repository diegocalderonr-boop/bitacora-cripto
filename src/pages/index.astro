---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const guias = (await getCollection('guias')).sort(
  (a, b) => new Date(b.data.fecha).getTime() - new Date(a.data.fecha).getTime()
);

const categorias = ['Arbitraje triangular', 'Arbitraje P2P', 'Arbitraje cash-and-carry'];

const categoryIcons: Record<string, string> = {
  'Arbitraje triangular': `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3L2 21h20L12 3z"/><path d="M12 8v4"/><path d="M8 16l4-4 4 4"/></svg>`,
  'Arbitraje P2P': `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="8" r="3"/><circle cx="17" cy="8" r="3"/><path d="M10 11h4"/><path d="M8 14l-1 1"/><path d="M16 14l1 1"/><path d="M7 18h10"/></svg>`,
  'Arbitraje cash-and-carry': `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20l4-8 4 4 4-12 6 16"/><line x1="3" y1="20" x2="21" y2="20"/></svg>`,
};
---

<Base title="Bitácora Cripto — Guías de arbitraje">
  <section class="hero">
    <div class="hero-content">
      <h1>Guías de arbitraje</h1>
      <p class="subtitle">Notas personales sobre mecanismos de arbitraje en cripto.</p>
    </div>
    <div class="hero-video-container">
      <video autoplay loop muted playsinline class="hero-video">
        <source src="/animacion.mp4" type="video/mp4" />
      </video>
    </div>
  </section>

  <div class="filters">
    <button class="filter-btn active" data-category="todas">Todas</button>
    {categorias.map((cat) => (
      <button class="filter-btn" data-category={cat}>{cat}</button>
    ))}
  </div>

  <div class="guia-list">
    {guias.map((guia) => (
      <article class="guia-card" data-category={guia.data.categoria}>
        <h2><a href={`/guias/${guia.id}`}>{guia.data.titulo}</a></h2>
        <div class="guia-meta">
          <span class={`tag tag-${guia.data.categoria === 'Arbitraje triangular' ? 'triangular' : guia.data.categoria === 'Arbitraje P2P' ? 'p2p' : 'cash'}`}>
            <Fragment set:html={categoryIcons[guia.data.categoria]} />
            {guia.data.categoria}
          </span>
          <time>{guia.data.fecha}</time>
        </div>
      </article>
    ))}
  </div>

  <div class="empty-state" id="empty" style="display:none;">
    No hay guías en esta categoría todavía.
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.guia-card');
  const empty = document.getElementById('empty');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = btn.getAttribute('data-category');
      let visible = 0;
      cards.forEach((card) => {
        const show = cat === 'todas' || card.getAttribute('data-category') === cat;
        (card as HTMLElement).style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (empty) empty.style.display = visible === 0 ? '' : 'none';
    });
  });
</script>
