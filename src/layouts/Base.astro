---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <div class="site-brand">
          <a href="/" class="site-title">Bitácora Cripto</a>
          <span class="site-subtitle">Notas personales sobre mecanismos de arbitraje en cripto</span>
        </div>
        <ul class="nav-links">
          <li><a href="/">Guías</a></li>
          <li><a href="/sobre-mi">Sobre mí</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      Bitácora personal de aprendizaje — No es asesoría financiera.
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
